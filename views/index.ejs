<!DOCTYPE html>
<html>
<head>
    <title>카페 메뉴 관리</title>
</head>
<body>
    <h1>카페 메뉴 목록</h1>
    <a href="/add">새로운 메뉴 추가하기</a>
    <table border="1" style="margin-top: 10px;">
        <tr>
            <th>ID</th>
            <th>메뉴명</th>
            <th>가격</th>
            <th>설명</th>
            <th>관리</th>
        </tr>
        <% menus.forEach(menu => { %>
        <tr>
            <td><%= menu.id %></td>
            <td><%= menu.name %></td>
            <td><%= menu.price %>원</td>
            <td><%= menu.description %></td>
            <td>
                <a href="/edit/<%= menu.id %>">수정</a>
                <a href="/delete/<%= menu.id %>" onclick="return confirm('정말 삭제하시겠습니까?');">삭제</a>
            </td>
        </tr>
        <% }) %>
    </table>
</body>
</html>