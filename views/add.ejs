<!DOCTYPE html>
<html>
<head>
    <title>메뉴 추가</title>
</head>
<body>
    <h1>새 메뉴 추가</h1>
    <form action="/add" method="POST">
        메뉴명: <input type="text" name="name" required><br><br>
        가격: <input type="number" name="price" required><br><br>
        설명: <textarea name="description"></textarea><br><br>
        <button type="submit">등록</button>
        <a href="/">취소</a>
    </form>
</body>
</html>